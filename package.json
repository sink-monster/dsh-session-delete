{
  "name": "dsh-session-delete",
  "version": "1.0.1",
  "description": "Adds open-session-storage-location and delete-session actions to the sidebar Session context menu.",
  "type": "module",
  "license": "MIT",
  "author": "sink-monster (https://github.com/sink-monster)",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "context-menu",
    "storage",
    "delete"
  ],
  "homepage": "https://github.com/sink-monster/dsh-session-delete#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sink-monster/dsh-session-delete.git"
  },
  "bugs": {
    "url": "https://github.com/sink-monster/dsh-session-delete/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "market",
    "README.md",
    "LICENSE",
    "README.zh-CN.md"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.5 <0.3.0"
  },
  "scripts": {
    "test": "node test/host.test.mjs && node test/client.test.mjs && node test/verify-index.mjs",
    "check": "node --check index.js && node --check client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
